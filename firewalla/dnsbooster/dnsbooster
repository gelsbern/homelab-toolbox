#!/bin/bash
set -u

REDIS="${REDIS:-redis-cli}"

# Automatically elevate when run as pi.
if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "ERROR: required command not found: $1" >&2
        exit 1
    }
}

need "$REDIS"
need jq
need ipset

usage() {
    cat <<'USAGE'
Usage:
  dnsbooster status [interface]
  dnsbooster reconcile

  dnsbooster net-off <interface>
  dnsbooster net-on <interface>

  dnsbooster devices-off
  dnsbooster devices-on

  dnsbooster gui-off
  dnsbooster gui-on

  dnsbooster all-off <interface>
  dnsbooster all-on <interface>

Examples:
  dnsbooster status
  dnsbooster status br0
  dnsbooster reconcile

  dnsbooster net-off br0
  dnsbooster net-on br0

  dnsbooster devices-off
  dnsbooster gui-off

  dnsbooster all-off br0
USAGE
}

merge_dns_policy() {
    local current="$1"
    local state="$2"

    [[ -n "$current" ]] || current='{}'

    if ! jq -e . >/dev/null 2>&1 <<<"$current"; then
        return 1
    fi

    jq -c --argjson state "$state" \
        '.dnsCaching = $state' <<<"$current"
}

find_network_key() {
    local wanted="$1"
    local key intf found=""

    while IFS= read -r key; do
        intf=$($REDIS --raw HGET "$key" intf)

        if [[ "$intf" == "$wanted" ]]; then
            if [[ -n "$found" ]]; then
                echo "ERROR: more than one network uses interface $wanted" >&2
                return 1
            fi

            found="$key"
        fi
    done < <($REDIS --scan --pattern 'network:uuid:*')

    if [[ -z "$found" ]]; then
        echo "ERROR: Firewalla network interface not found: $wanted" >&2
        return 1
    fi

    printf '%s\n' "$found"
}

set_network() {
    local intf="$1"
    local state="$2"
    local key uuid type current new payload word

    key=$(find_network_key "$intf") || exit 1
    uuid="${key#network:uuid:}"
    type=$($REDIS --raw HGET "$key" type)

    if [[ "$type" != "lan" ]]; then
        echo "ERROR: refusing to change DNS Booster on non-LAN interface $intf (type=$type)" >&2
        exit 1
    fi

    current=$($REDIS --raw HGET "policy:network:$uuid" dnsmasq)

    if ! new=$(merge_dns_policy "$current" "$state"); then
        echo "ERROR: invalid existing dnsmasq JSON on network $intf; nothing changed" >&2
        exit 1
    fi

    $REDIS HSET \
        "policy:network:$uuid" \
        dnsmasq \
        "$new" >/dev/null

    payload=$(jq -cn \
        --arg type "$uuid" \
        --arg id "dnsmasq" \
        --argjson policy "$new" \
        '{type:$type,id:$id,msg:{dnsmasq:$policy}}')

    $REDIS PUBLISH \
        'Network:PolicyChanged' \
        "$payload" >/dev/null

    [[ "$state" == "false" ]] && word="OFF" || word="ON"

    echo "Network $intf: DNS Booster $word"
    echo "  UUID:   $uuid"
    echo "  Policy: $new"
}

set_devices() {
    local state="$1"
    local key mac pkey current new payload curstate word
    local total=0 changed=0 unchanged=0 skipped=0
    local ipset_added=0 ipset_removed=0 ipset_already=0

    [[ "$state" == "false" ]] \
        && word="OFF / unchecked" \
        || word="ON / checked"

    while IFS= read -r key; do
        mac="${key#host:mac:}"

        # Ignore malformed host keys.
        if [[ ! "$mac" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; then
            skipped=$((skipped + 1))
            continue
        fi

        total=$((total + 1))
        pkey="policy:mac:$mac"

        current=$($REDIS --raw HGET "$pkey" dnsmasq)
        [[ -n "$current" ]] || current='{}'

        # Never overwrite malformed existing JSON.
        if ! jq -e . >/dev/null 2>&1 <<<"$current"; then
            echo "WARNING: $mac has invalid dnsmasq JSON; skipped: $current" >&2
            skipped=$((skipped + 1))
            continue
        fi

        curstate=$(
            jq -r '
                if has("dnsCaching")
                then (.dnsCaching | tostring)
                else "unset"
                end
            ' <<<"$current"
        )

        if [[ "$curstate" == "$state" ]]; then
            unchanged=$((unchanged + 1))
        else
            # Preserve every existing dnsmasq field and only change dnsCaching.
            new=$(
                jq -c \
                    --argjson state "$state" \
                    '.dnsCaching = $state' \
                    <<<"$current"
            )

            $REDIS HSET \
                "$pkey" \
                dnsmasq \
                "$new" >/dev/null

            payload=$(jq -cn \
                --arg type "$mac" \
                --arg id "dnsmasq" \
                --argjson policy "$new" \
                '{type:$type,id:$id,msg:{dnsmasq:$policy}}')

            $REDIS PUBLISH \
                'Host:PolicyChanged' \
                "$payload" >/dev/null

            changed=$((changed + 1))
        fi

        # Belt and suspenders: always reconcile the live MAC bypass ipset,
        # even when the persistent Redis policy was already correct.
        if [[ "$state" == "false" ]]; then
            if ipset test no_dns_caching_mac_set "$mac" >/dev/null 2>&1; then
                ipset_already=$((ipset_already + 1))
            else
                ipset -exist add no_dns_caching_mac_set "$mac"
                ipset_added=$((ipset_added + 1))
            fi
        else
            if ipset test no_dns_caching_mac_set "$mac" >/dev/null 2>&1; then
                ipset -exist del no_dns_caching_mac_set "$mac"
                ipset_removed=$((ipset_removed + 1))
            else
                ipset_already=$((ipset_already + 1))
            fi
        fi
    done < <($REDIS --scan --pattern 'host:mac:*')

    echo "Devices: DNS Booster $word"
    echo "  Known devices:       $total"
    echo "  Redis changed:       $changed"
    echo "  Redis already set:   $unchanged"
    echo "  Skipped:             $skipped"

    if [[ "$state" == "false" ]]; then
        echo "  Added to live ipset: $ipset_added"
        echo "  Already in ipset:    $ipset_already"
    else
        echo "  Removed from ipset:  $ipset_removed"
        echo "  Already absent:      $ipset_already"
    fi
}

wait_for_runtime() {
    local max_attempts="${1:-30}"
    local attempt

    for ((attempt=1; attempt<=max_attempts; attempt++)); do
        if [[ "$($REDIS --raw PING 2>/dev/null)" == "PONG" ]] && \
           ipset list no_dns_caching_set >/dev/null 2>&1 && \
           ipset list no_dns_caching_mac_set >/dev/null 2>&1; then
            return 0
        fi

        sleep 2
    done

    echo "ERROR: Firewalla DNS Booster ipsets were not ready after $((max_attempts * 2)) seconds." >&2
    return 1
}

reconcile_networks() {
    local key type intf uuid raw desired prefix member
    local total=0 off=0 on=0 unset=0 invalid=0
    local added=0 removed=0 already=0 missing=0

    while IFS= read -r key; do
        type=$($REDIS --raw HGET "$key" type)
        [[ "$type" == "lan" ]] || continue

        total=$((total + 1))
        intf=$($REDIS --raw HGET "$key" intf)
        uuid="${key#network:uuid:}"
        raw=$($REDIS --raw HGET "policy:network:$uuid" dnsmasq)

        if [[ -z "$raw" ]]; then
            # No network-level dnsmasq policy means Firewalla default: Booster ON.
            desired="true"
            unset=$((unset + 1))
        elif ! jq -e . >/dev/null 2>&1 <<<"$raw"; then
            echo "WARNING: $intf ($uuid) has invalid network dnsmasq JSON; skipped: $raw" >&2
            invalid=$((invalid + 1))
            continue
        elif [[ "$(jq -r '.dnsCaching == true' <<<"$raw")" == "true" ]]; then
            desired="true"
            on=$((on + 1))
        else
            # Mirrors NetworkProfile._dnsmasq(): anything other than strict true is OFF.
            desired="false"
            off=$((off + 1))
        fi

        prefix="${uuid:0:13}"

        for member in \
            "c_net_${prefix}_set" \
            "c_net_${prefix}_set6" \
            "c_net_ll6_${prefix}_set6"
        do
            # list:set cannot contain a child set that does not exist yet.
            if ! ipset list "$member" >/dev/null 2>&1; then
                missing=$((missing + 1))
                continue
            fi

            if [[ "$desired" == "false" ]]; then
                if ipset test no_dns_caching_set "$member" >/dev/null 2>&1; then
                    already=$((already + 1))
                else
                    ipset -exist add no_dns_caching_set "$member"
                    added=$((added + 1))
                fi
            else
                if ipset test no_dns_caching_set "$member" >/dev/null 2>&1; then
                    ipset -exist del no_dns_caching_set "$member"
                    removed=$((removed + 1))
                else
                    already=$((already + 1))
                fi
            fi
        done
    done < <($REDIS --scan --pattern 'network:uuid:*')

    echo "Networks"
    echo "  LAN networks:               $total"
    echo "  Explicitly OFF:             $off"
    echo "  Explicitly ON:              $on"
    echo "  Unset (default ON):         $unset"
    echo "  Invalid policy JSON:        $invalid"
    echo "  Added to live bypass set:   $added"
    echo "  Removed from bypass set:    $removed"
    echo "  Already correct:            $already"
    echo "  Child ipsets not available: $missing"
}

reconcile_devices() {
    local key mac raw desired
    local total=0 off=0 on=0 unset=0 invalid=0
    local added=0 removed=0 already=0

    while IFS= read -r key; do
        mac="${key#host:mac:}"

        [[ "$mac" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] || continue

        total=$((total + 1))
        raw=$($REDIS --raw HGET "policy:mac:$mac" dnsmasq)

        if [[ -z "$raw" ]]; then
            # No device-level dnsmasq policy means Firewalla default: Booster ON.
            desired="true"
            unset=$((unset + 1))
        elif ! jq -e . >/dev/null 2>&1 <<<"$raw"; then
            echo "WARNING: $mac has invalid device dnsmasq JSON; skipped: $raw" >&2
            invalid=$((invalid + 1))
            continue
        elif [[ "$(jq -r '.dnsCaching == true' <<<"$raw")" == "true" ]]; then
            desired="true"
            on=$((on + 1))
        else
            # Mirrors Host._dnsmasq(): anything other than strict true is OFF.
            desired="false"
            off=$((off + 1))
        fi

        if [[ "$desired" == "false" ]]; then
            if ipset test no_dns_caching_mac_set "$mac" >/dev/null 2>&1; then
                already=$((already + 1))
            else
                ipset -exist add no_dns_caching_mac_set "$mac"
                added=$((added + 1))
            fi
        else
            if ipset test no_dns_caching_mac_set "$mac" >/dev/null 2>&1; then
                ipset -exist del no_dns_caching_mac_set "$mac"
                removed=$((removed + 1))
            else
                already=$((already + 1))
            fi
        fi
    done < <($REDIS --scan --pattern 'host:mac:*')

    echo "Devices"
    echo "  Known devices:              $total"
    echo "  Explicitly OFF / unchecked: $off"
    echo "  Explicitly ON / checked:    $on"
    echo "  Unset (default ON):         $unset"
    echo "  Invalid policy JSON:        $invalid"
    echo "  Added to live bypass set:   $added"
    echo "  Removed from bypass set:    $removed"
    echo "  Already correct:            $already"
}

reconcile_runtime() {
    echo "===== DNS BOOSTER RUNTIME RECONCILE ====="
    echo "Reading persistent Firewalla Redis policy; no policy values will be changed."
    echo

    wait_for_runtime || return 1

    reconcile_networks
    echo
    reconcile_devices
    echo
    echo "Runtime DNS Booster ipsets now match persistent policy."
}

network_status_one() {
    local intf="$1"
    local key uuid subnet raw state prefix active

    key=$(find_network_key "$intf") || return 1

    uuid="${key#network:uuid:}"
    subnet=$($REDIS --raw HGET "$key" ipv4Subnet)
    raw=$($REDIS --raw HGET "policy:network:$uuid" dnsmasq)

    if [[ -z "$raw" ]]; then
        state="unset (Firewalla default)"

    elif jq -e . >/dev/null 2>&1 <<<"$raw"; then
        case "$(
            jq -r '
                if has("dnsCaching")
                then (.dnsCaching | tostring)
                else "unset"
                end
            ' <<<"$raw"
        )" in
            false)
                state="OFF"
                ;;
            true)
                state="ON"
                ;;
            *)
                state="unset inside dnsmasq policy"
                ;;
        esac
    else
        state="INVALID JSON: $raw"
    fi

    prefix="${uuid:0:13}"

    if ipset list no_dns_caching_set 2>/dev/null |
        grep -Fqx "c_net_${prefix}_set"; then
        active="YES"
    else
        active="NO"
    fi

    echo "$intf  $subnet"
    echo "  UUID:                      $uuid"
    echo "  Stored policy:             $state"
    echo "  Network bypass IPset:      $active"
}

status_devices() {
    local key mac raw val
    local total=0 off=0 on=0 unset=0 invalid=0 active=0

    while IFS= read -r key; do
        mac="${key#host:mac:}"

        [[ "$mac" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] ||
            continue

        total=$((total + 1))

        raw=$(
            $REDIS --raw \
                HGET "policy:mac:$mac" dnsmasq
        )

        if [[ -z "$raw" ]]; then
            unset=$((unset + 1))
            continue
        fi

        if ! jq -e . >/dev/null 2>&1 <<<"$raw"; then
            invalid=$((invalid + 1))
            continue
        fi

        val=$(
            jq -r '
                if has("dnsCaching")
                then (.dnsCaching | tostring)
                else "unset"
                end
            ' <<<"$raw"
        )

        case "$val" in
            false)
                off=$((off + 1))
                ;;
            true)
                on=$((on + 1))
                ;;
            *)
                unset=$((unset + 1))
                ;;
        esac
    done < <($REDIS --scan --pattern 'host:mac:*')

    active=$(
        ipset list no_dns_caching_mac_set 2>/dev/null |
            awk '/Number of entries:/ {print $4; exit}'
    )

    [[ -n "$active" ]] || active="unknown"

    echo "Devices"
    echo "  Known:                       $total"
    echo "  Explicitly OFF / unchecked: $off"
    echo "  Explicitly ON / checked:    $on"
    echo "  Unset (default ON):          $unset"
    echo "  Invalid policy JSON:         $invalid"
    echo "  Currently in bypass IPset:   $active"
}

status_all_networks() {
    local key intf type

    echo "Networks"

    while IFS= read -r key; do
        type=$($REDIS --raw HGET "$key" type)

        [[ "$type" == "lan" ]] || continue

        intf=$($REDIS --raw HGET "$key" intf)

        network_status_one "$intf"
        echo
    done < <($REDIS --scan --pattern 'network:uuid:*')
}

cmd="${1:-help}"

case "$cmd" in
    status)
        if [[ -n "${2:-}" ]]; then
            network_status_one "$2"
            echo
        else
            status_all_networks
        fi

        status_devices
        ;;

    reconcile)
        reconcile_runtime
        ;;

    net-off)
        [[ -n "${2:-}" ]] || {
            usage
            exit 1
        }

        set_network "$2" false
        ;;

    net-on)
        [[ -n "${2:-}" ]] || {
            usage
            exit 1
        }

        set_network "$2" true
        ;;

    devices-off|gui-off)
        set_devices false
        ;;

    devices-on|gui-on)
        set_devices true
        ;;

    all-off)
        [[ -n "${2:-}" ]] || {
            usage
            exit 1
        }

        set_network "$2" false
        set_devices false
        ;;

    all-on)
        [[ -n "${2:-}" ]] || {
            usage
            exit 1
        }

        set_network "$2" true
        set_devices true
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        echo "ERROR: unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
